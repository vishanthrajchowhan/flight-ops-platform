{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-flightops-dev-uv0zba"
		},
		"ls_adls_datalake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://stflightopsdevuv0zba.dfs.core.windows.net/"
		},
		"ls_databricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1011-154753-hq8zgn8i"
		},
		"ls_http_bts_files_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://transtats.bts.gov/PREZIP/"
		},
		"tr_monthly_bts_refresh_properties_pl_monthly_bts_refresh_parameters_year": {
			"type": "string",
			"defaultValue": "@formatDateTime(addToTime(trigger().scheduledTime, -2, 'Month'), 'yyyy')"
		},
		"tr_monthly_bts_refresh_properties_pl_monthly_bts_refresh_parameters_month": {
			"type": "string",
			"defaultValue": "@string(int(formatDateTime(addToTime(trigger().scheduledTime, -2, 'Month'), 'MM')))"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-flightops-dev-uv0zba_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_datalake_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_datalake_properties_typeProperties_url')]"
					},
					"ls_databricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_databricks_properties_typeProperties_existingClusterId')]"
					},
					"ls_http_bts_files_properties_typeProperties_url": {
						"value": "[parameters('ls_http_bts_files_properties_typeProperties_url')]"
					},
					"tr_monthly_bts_refresh_properties_pl_monthly_bts_refresh_parameters_year": {
						"value": "[parameters('tr_monthly_bts_refresh_properties_pl_monthly_bts_refresh_parameters_year')]"
					},
					"tr_monthly_bts_refresh_properties_pl_monthly_bts_refresh_parameters_month": {
						"value": "[parameters('tr_monthly_bts_refresh_properties_pl_monthly_bts_refresh_parameters_month')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}