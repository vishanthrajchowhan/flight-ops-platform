model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["aa_hub_performance","carrier_daily_performance","delay_cause_breakdown","route_performance","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table aa_hub_performance
ref table carrier_daily_performance
ref table delay_cause_breakdown
ref table route_performance
ref table Date
ref table Carrier
ref table _Measures

ref cultureInfo en-US

