	partition Date = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        MIN(carrier_daily_performance[flight_date]),
				        MAX(carrier_daily_performance[flight_date])
				    ),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month", FORMAT([Date], "MMM"),
				    "Year-Month", FORMAT([Date], "yyyy-MM"),
				    "Month Start", DATE(YEAR([Date]), MONTH([Date]), 1)
				)

	annotation PBI_Id = 0aa0d0e0eb3e476496434c84fdcdc777

